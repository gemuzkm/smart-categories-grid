{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smart-cat-grid/categories-grid",
  "version": "2.4.1",
  "title": "Categories Grid",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Responsive category navigation with server-side caching, optional images and five visual styles.",
  "keywords": ["categories", "subcategories", "grid", "taxonomy"],
  "textdomain": "smart-cat-grid",
  "supports": {"html": false, "anchor": true, "align": ["wide", "full"], "spacing": {"margin": true}},
  "attributes": {
    "auto": {"type": "boolean", "default": false},
    "type": {"type": "string", "default": "subcategories"},
    "categoryId": {"type": "integer", "default": 0},
    "exclude": {"type": "string", "default": ""},
    "hideEmpty": {"type": "boolean", "default": false},
    "showImages": {"type": "string", "default": ""},
    "limit": {"type": "string", "default": ""},
    "showViewAll": {"type": "boolean", "default": true},
    "columns": {"type": "string", "default": ""},
    "style": {"type": "string", "default": ""},
    "hoverEffect": {"type": "string", "default": ""},
    "imageRadius": {"type": "string", "default": ""},
    "buttonColor": {"type": "string", "default": ""}
  },
  "example": {"attributes": {"type": "top-level", "limit": "6", "columns": "3"}},
  "editorScript": "scg-block-editor",
  "editorStyle": "scg-front"
}
