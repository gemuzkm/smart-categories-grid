{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smart-cat-grid/categories-grid",
  "version": "2.3.0",
  "title": "Categories Grid",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Responsive grid of categories or subcategories with images, caching and five visual styles.",
  "keywords": ["categories", "subcategories", "grid", "taxonomy"],
  "textdomain": "smart-cat-grid",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "margin": true }
  },
  "attributes": {
    "auto":        { "type": "boolean", "default": false },
    "type":        { "type": "string",  "default": "subcategories", "enum": ["subcategories", "top-level"] },
    "categoryId":  { "type": "integer", "default": 0 },
    "exclude":     { "type": "string",  "default": "" },
    "showImages":  { "type": "string",  "default": "", "enum": ["", "true", "false"] },
    "limit":       { "type": "string",  "default": "" },
    "columns":     { "type": "string",  "default": "", "enum": ["", "2", "3", "4", "5", "6"] },
    "style":       { "type": "string",  "default": "", "enum": ["", "classic", "modern", "minimal", "card", "text"] },
    "hoverEffect": { "type": "string",  "default": "", "enum": ["", "true", "false"] },
    "imageRadius": { "type": "string",  "default": "" },
    "buttonColor": { "type": "string",  "default": "" }
  },
  "example": { "attributes": { "type": "top-level", "limit": "6", "columns": "3" } },
  "editorScript": "scg-block-editor",
  "style": "scg-front"
}
